PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://weldrr:weldrr@localhost:5432/weldrr
LOG_LEVEL=info

JWT_SECRET=replace-with-a-long-random-string-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# GitHub OAuth App (for connecting a git repo when creating a project)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Defaults to PUBLIC_URL/api/github/callback
GITHUB_CALLBACK_URL=

ZEPTOMAIL_TOKEN=
ZEPTOMAIL_FROM=noreply@weldrr.com
ZEPTOMAIL_FROM_NAME=Weldrr

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=weldrr
R2_PUBLIC_URL=http://localhost:3000

OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini

# Modal sandbox runtime (agent that builds SDKs/docs)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_ENVIRONMENT=
MODAL_APP_NAME=weldrr-sandboxes
MODAL_IMAGE_NAME=weldrr-sandbox-runtime

# API key injected into agent sandboxes for opencode's LLM provider
# (matches the provider prefix of SANDBOX_OPENCODE_MODEL, e.g. opencode-go or deepseek)
SANDBOX_PROVIDER_API_KEY=
# opencode model id (provider-prefixed)
SANDBOX_OPENCODE_MODEL=opencode-go/deepseek-v4-flash
SANDBOX_OPENCODE_PORT=4096
SANDBOX_TIMEOUT_MS=3600000
SANDBOX_IDLE_TIMEOUT_MS=900000
# Public URL the sandbox calls back to (must be reachable from Modal).
# Leave empty to derive from PUBLIC_URL/PORT.
SANDBOX_CALLBACK_URL=
# Optional key for encrypting sandbox secrets at rest (AES-256-GCM).
# Leave empty to derive from JWT_SECRET.
SANDBOX_CREDENTIAL_ENCRYPTION_KEY=
# JSON map language/template -> git template URL cloned into each sandbox
SANDBOX_TEMPLATES={"typescript":"","python":"","java":"","go":"","ruby":"","php":"","docs":""}